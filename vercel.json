{
  "version": 2,
  "builds": [
    { "src": "web/index.html", "use": "@vercel/static" },
    { "src": "web/**", "use": "@vercel/static" },
    { "src": "api/score.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/score", "dest": "/api/score.py" },
    { "src": "/privacy/?", "dest": "/web/privacy.html" },
    { "src": "/privacy\\.html", "dest": "/web/privacy.html" },
    { "src": "/(style\\.css|app\\.js|privacy\\.js|robots\\.txt|sitemap\\.xml|logo\\.png|favicon\\.ico|favicon-32\\.png|apple-touch-icon\\.png|seoryon-mark\\.svg)", "dest": "/web/$1" },
    { "src": "/(.*\\.(png|jpg|jpeg|svg|ico|webp|gif|woff2?))", "dest": "/web/$1" },
    { "src": "/(.*)", "dest": "/web/index.html" }
  ]
}
